# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=travel_planner
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/travel_planner

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

CORS_ORIGINS=http://localhost,http://localhost:5173,http://localhost:4173,http://192.168.0.102

YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=http://localhost:80/auth/yandex/callback

SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=your-email@yandex.ru
SMTP_PASSWORD=your-app-password
SMTP_FROM_NAME=Triply
SMTP_USE_TLS=true

# Currency converter
FXR_API_KEY=your-api-key

FRONTEND_URL=http://localhost:80

# Yandex Maps (JavaScript API + HTTP Geocoder key)
VITE_YANDEX_MAPS_API_TOKEN=your_yandex_maps_api_key_here

# Geoapify Geocoding
VITE_GEOAPIFY_API_KEY=your_geoapify_api_key_here

# Yandex Geosuggest (отдельный ключ от Maps API, suggest-maps.yandex.ru)
VITE_YANDEX_GEOSUGGEST_API_KEY=your_yandex_geosuggest_api_key_here

OPENTRIPMAP_API_KEY=