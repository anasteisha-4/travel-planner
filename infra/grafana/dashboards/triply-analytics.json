          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COALESCE(context->>'method', '-') AS method,\n       COALESCE(context->>'path', entity_id, '-') AS path,\n       count(*) FILTER (WHERE event_type = 'failed_api_request') AS failed,\n       count(*) FILTER (WHERE event_type = 'slow_api_request') AS slow,\n       round(avg(NULLIF(context->>'duration_ms', '')::numeric) FILTER (WHERE event_type = 'slow_api_request'), 0) AS avg_slow_ms,\n       max(created_at) AS last_seen\nFROM user_events\nWHERE $__timeFilter(created_at)\n  AND event_type IN ('failed_api_request', 'slow_api_request')\nGROUP BY 1, 2\nORDER BY failed DESC, slow DESC, last_seen DESC\nLIMIT 30;",
          "refId": "A"
        }
      ],
      "title": "API Incident Hotspots",
      "type": "table"
