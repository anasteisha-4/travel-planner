          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT date_trunc('hour', created_at) AS time,\n       count(*) FILTER (WHERE event_type = 'failed_api_request') AS failed_api,\n       count(*) FILTER (WHERE event_type = 'slow_api_request') AS slow_api,\n       count(*) FILTER (WHERE event_type IN ('frontend_error', 'frontend_unhandled_rejection', 'service_worker_error')) AS frontend_errors\nFROM user_events\nWHERE $__timeFilter(created_at)\nGROUP BY 1\nORDER BY 1;",
