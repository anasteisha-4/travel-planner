          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH funnel(event_type, step_order) AS (\n  VALUES\n    ('recommendation_shown', 1),\n    ('recommendation_impression', 2),\n    ('recommendation_clicked', 3),\n    ('destination_detail_opened', 4),\n    ('trip_created', 5)\n), counts AS (\n  SELECT event_type, count(*) AS count\n  FROM user_events\n  WHERE $__timeFilter(created_at)\n    AND event_type IN (SELECT event_type FROM funnel)\n  GROUP BY event_type\n), base AS (\n  SELECT NULLIF((SELECT count FROM counts WHERE event_type = 'recommendation_shown'), 0) AS base_count\n)\nSELECT f.step_order,\n       f.event_type,\n       COALESCE(c.count, 0) AS count,\n       round(COALESCE(c.count, 0)::numeric / b.base_count * 100, 2) AS conversion_pct\nFROM funnel f\nLEFT JOIN counts c USING (event_type)\nCROSS JOIN base b\nORDER BY f.step_order;",
          "refId": "A"
        }
      ],
      "title": "Recommendation Funnel",
      "type": "table"
    },
