          "rawQuery": true,
          "rawSql": "SELECT created_at,\n       event_type,\n       COALESCE(context->>'method', '-') AS method,\n       COALESCE(context->>'path', entity_id, '-') AS path,\n       context->>'status' AS status,\n       context->>'duration_ms' AS duration_ms,\n       context->>'message' AS message\nFROM user_events\nWHERE $__timeFilter(created_at)\n  AND event_type IN ('failed_api_request', 'slow_api_request', 'frontend_error', 'frontend_unhandled_rejection', 'service_worker_error')\nORDER BY created_at DESC\nLIMIT 50;",
