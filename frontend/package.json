{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode docker",
    "build": "tsc -b && vite build --mode docker",
    "lint": "eslint . && npm run steiger",
