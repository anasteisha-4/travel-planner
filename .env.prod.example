# Production environment for Yandex Cloud VM
# Copy to .env.prod and fill in values. Do NOT commit .env.prod.

# --- PostgreSQL (docker-compose only, not read by services directly) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=travel_planner

# --- All services ---
DATABASE_URL=postgresql://postgres:change-me-strong-password@postgres:5432/travel_planner
REDIS_URL=redis://redis:6379
JWT_SECRET=change-me-64-char-random-string

# CORS — домен и IP VM
CORS_ORIGINS=http://<VM_PUBLIC_IP>,https://<DOMEN>

# --- auth-service ---
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=https://<DOMEN>/auth/yandex/callback
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Triply
FRONTEND_URL=http://<VM_PUBLIC_IP>

# --- trip-service ---
FXR_API_KEY=

# --- data-service ---
INTERNAL_API_SECRET=change-me-internal-secret

# --- ml-service ---
DATA_SERVICE_SECRET=change-me-data-secret
# TRIP_SERVICE_URL, DATA_SERVICE_URL и ANALYTICS_SERVICE_URL имеют дефолты http://<service>:8000
# менять не нужно если имена сервисов в docker-compose не меняются

# --- Frontend (передаются как build args в docker compose build) ---
VITE_YANDEX_MAPS_API_TOKEN=
VITE_GEOAPIFY_API_KEY=
VITE_YANDEX_GEOSUGGEST_API_KEY=

TRAVELPAYOUTS_API_TOKEN=