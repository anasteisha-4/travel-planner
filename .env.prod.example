# Production environment for Yandex Cloud VM
# Copy to .env.prod and fill in values. Do NOT commit .env.prod.

# --- PostgreSQL (docker-compose only, not read by services directly) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=travel_planner

# --- All services ---
DATABASE_URL=postgresql://postgres:change-me-strong-password@postgres:5432/travel_planner
REDIS_URL=redis://redis:6379
JWT_SECRET=change-me-64-char-random-string
ADMIN_USER_IDS=

# --- grafana ---
GF_SECURITY_ADMIN_USER=grafana_admin
GF_SECURITY_ADMIN_PASSWORD=change-me-strong-password
VITE_GRAFANA_DASHBOARD_URL=/grafana/d/triply-analytics/triply-analytics?orgId=1&from=now-14d&to=now
# CORS — домен и IP VM
CORS_ORIGINS=http://<VM_PUBLIC_IP>,https://<DOMEN>

# --- auth-service ---
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=https://<DOMEN>/auth/yandex/callback
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Triply
FRONTEND_URL=http://<VM_PUBLIC_IP>

# --- trip-service ---
FXR_API_KEY=

# --- data-service ---
INTERNAL_API_SECRET=change-me-internal-secret

# --- ml-service ---
DATA_SERVICE_SECRET=change-me-data-secret
# TRIP_SERVICE_URL, DATA_SERVICE_URL и ANALYTICS_SERVICE_URL имеют дефолты http://<service>:8000
# менять не нужно если имена сервисов в docker-compose не меняются
LLM_QUALITY_ENABLED=true
LLM_PROVIDER=yandex
# Exact API model id must be copied from Yandex AI Studio Model Gallery.
# UI-selected target for this project: Qwen3.6 35B.
LLM_MODEL=qwen3.6-35b-a3b/latest
LLM_API_KEY=
LLM_FOLDER_ID=
LLM_BASE_URL=https://ai.api.cloud.yandex.net/v1
LLM_DATA_LOGGING_ENABLED=false
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=1
LLM_CACHE_TTL_SECONDS=86400
LLM_RECOMMENDATION_REVIEW_LIMIT=10
LLM_ITINERARY_REVIEW_VARIANTS=3
LLM_NOTES_MAX_CHARS=1200
LLM_EXTERNAL_ROUTE_MAX_TOKENS=8000
LLM_CANDIDATE_POI_ENABLED=true
LLM_EXTERNAL_ROUTE_ENABLED=true
LLM_FAIL_OPEN=true
LLM_LOG_RAW_PROMPTS=false

# Trip-service waits for ML itinerary generation, including optional LLM quality review.
ML_SERVICE_TIMEOUT_SECONDS=180

# Deploy order for LLM:
# 1) set LLM_QUALITY_ENABLED=true only after smoke with valid LLM_API_KEY/LLM_FOLDER_ID.
# 2) keep LLM_CANDIDATE_POI_ENABLED and LLM_EXTERNAL_ROUTE_ENABLED off
#    until admin review flows and provider smoke pass in production.

# --- Frontend (передаются как build args в docker compose build) ---
VITE_API_URL=
VITE_YANDEX_MAPS_API_TOKEN=
VITE_GEOAPIFY_API_KEY=
VITE_YANDEX_GEOSUGGEST_API_KEY=

TRAVELPAYOUTS_API_TOKEN=
