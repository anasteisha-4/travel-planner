# Production environment for local docker compose
# Copy to .env.docker and fill in values. Do NOT commit .env.docker.

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=travel_planner

# --- All services ---
DATABASE_URL=postgresql://postgres:change-me-strong-password@localhost:5432/travel_planner
REDIS_URL=redis://redis:6379
JWT_SECRET=change-me-64-char-random-string
ADMIN_USER_IDS=

# --- grafana ---
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change-me-strong-password
VITE_GRAFANA_DASHBOARD_URL=/grafana/d/triply-analytics/triply-analytics?orgId=1&from=now-14d&to=now

CORS_ORIGINS=http://localhost,http://localhost:5173,http://localhost:4173

# --- auth-service ---
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=http://localhost:80/auth/yandex/callback
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Triply
FRONTEND_URL=http://localhost:80 # для dev версии использовать 5173 порт

# --- trip-service ---
# Currency converter
FXR_API_KEY=

# --- data-service ---
INTERNAL_API_SECRET=change-me-internal-secret

# --- ml-service ---
DATA_SERVICE_SECRET=change-me-data-secret
LLM_QUALITY_ENABLED=false
LLM_PROVIDER=yandex
# Exact API model id must be copied from Yandex AI Studio Model Gallery.
# UI-selected target for this project: Qwen3.6 35B.
LLM_MODEL=qwen3.6-35b-a3b/latest
LLM_API_KEY=
LLM_FOLDER_ID=
LLM_BASE_URL=https://ai.api.cloud.yandex.net/v1
LLM_DATA_LOGGING_ENABLED=false
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=1
LLM_CACHE_TTL_SECONDS=86400
LLM_RECOMMENDATION_REVIEW_LIMIT=10
LLM_ITINERARY_REVIEW_VARIANTS=3
LLM_NOTES_MAX_CHARS=1200
LLM_EXTERNAL_ROUTE_MAX_TOKENS=8000
LLM_EXTERNAL_ROUTE_TIMEOUT_SECONDS=18
LLM_EXTERNAL_ROUTE_COORDINATE_REPAIR_ENABLED=false
LLM_CANDIDATE_POI_ENABLED=false
LLM_EXTERNAL_ROUTE_ENABLED=false
LLM_FAIL_OPEN=true
LLM_LOG_RAW_PROMPTS=false

# Trip-service waits for ML itinerary generation, including optional LLM quality review.
ML_SERVICE_TIMEOUT_SECONDS=180
# Local LLM smoke order:
# 1) fill LLM_API_KEY and LLM_FOLDER_ID;
# 2) set LLM_QUALITY_ENABLED=true;
# 3) enable candidate/external flags only after basic review smoke passes.

# --- Frontend ---
VITE_API_URL=

# Server-side map/geocoding keys. Do not expose as VITE_*.
YANDEX_MAPS_API_TOKEN=
YANDEX_GEOSUGGEST_API_KEY=
GEOAPIFY_API_KEY=

TRAVELPAYOUTS_API_TOKEN=
LLM_EXTERNAL_ROUTE_COORDINATE_REPAIR_ENABLED=true

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:email@example.com